rules_version = '2';
// Serwis nie przechowuje plików (parser przetwarza PDF/XLSX w pamięci i niczego nie zapisuje),
// więc magazyn jest zamknięty w całości. Jeśli kiedyś będą pliki użytkowników: osobna ścieżka
// users/{uid}/..., dostęp tylko dla właściciela, limit rozmiaru i typu, szyfrowanie po stronie aplikacji.
// Wdrożenie: firebase deploy --only storage --project <NEXT_PUBLIC_FIREBASE_PROJECT_ID>
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
