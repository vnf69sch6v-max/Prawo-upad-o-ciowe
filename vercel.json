{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build",
    "framework": "nextjs",
    "regions": [
        "fra1"
    ],
    "crons": [
        {
            "path": "/api/cron/dbw-1",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/cron/dbw-2",
            "schedule": "30 3 * * *"
        },
        {
            "path": "/api/cron/dbw-3",
            "schedule": "0 4 * * *"
        },
        {
            "path": "/api/cron/dbw-4",
            "schedule": "30 4 * * *"
        },
        {
            "path": "/api/cron/bdl",
            "schedule": "0 5 * * *"
        },
        {
            "path": "/api/cron/nbp",
            "schedule": "0 13 * * 1-5"
        },
        {
            "path": "/api/cron/stooq",
            "schedule": "20 15 * * 1-5"
        },
        {
            "path": "/api/cron/stooq-intraday",
            "schedule": "0 14 * * 1-5"
        },
        {
            "path": "/api/cron/gus",
            "schedule": "0 11 * * 1"
        },
        {
            "path": "/api/cron/refresh",
            "schedule": "0 6 * * *"
        },
        {
            "path": "/api/cron/freshness",
            "schedule": "20 7 * * *"
        },
        {
            "path": "/api/cron/news-archive",
            "schedule": "0 20 * * *"
        },
        {
            "path": "/api/cron/news-digest",
            "schedule": "5 16 * * *"
        }
    ],
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Access-Control-Allow-Methods",
                    "value": "GET, POST, PUT, DELETE, PATCH, OPTIONS"
                },
                {
                    "key": "Access-Control-Allow-Headers",
                    "value": "Content-Type, Authorization"
                }
            ]
        }
    ],
    "functions": {
        "src/app/api/**/*.ts": {
            "maxDuration": 30
        },
        "src/app/api/parser/parse/route.ts": {
            "maxDuration": 60
        },
        "src/app/api/cron/news-digest/route.ts": {
            "maxDuration": 60
        },
        "src/app/api/cron/news-archive/route.ts": {
            "maxDuration": 60
        },
        "src/app/api/cron/refresh/route.ts": {
            "maxDuration": 120
        },
        "src/app/api/cron/dbw-1/route.ts": {
            "maxDuration": 120
        },
        "src/app/api/cron/dbw-2/route.ts": {
            "maxDuration": 120
        },
        "src/app/api/cron/dbw-3/route.ts": {
            "maxDuration": 120
        },
        "src/app/api/cron/dbw-4/route.ts": {
            "maxDuration": 120
        },
        "src/app/api/cron/bdl/route.ts": {
            "maxDuration": 120
        },
        "src/app/api/cron/freshness/route.ts": {
            "maxDuration": 120
        },
        "src/app/api/cron/nbp/route.ts": {
            "maxDuration": 120
        },
        "src/app/api/cron/stooq/route.ts": {
            "maxDuration": 120
        },
        "src/app/api/cron/stooq-intraday/route.ts": {
            "maxDuration": 120
        },
        "src/app/api/gus-cpi-full/route.ts": {
            "maxDuration": 120
        },
        "src/app/api/gus-ppi-full/route.ts": {
            "maxDuration": 120
        }
    }
}
